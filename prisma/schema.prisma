// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs moved to prisma.config.ts (Prisma 7 no longer supports
  // `url`/`directUrl` in the schema). The app passes a driver adapter to
  // PrismaClient; Migrate reads its connection from prisma.config.ts.
}

model Group {
  id           String        @id
  name         String
  information  String?       @db.Text
  currency     String        @default("$")
  currencyCode String?
  participants Participant[]
  expenses     Expense[]
  activities   Activity[]
  receipts     Receipt[]
  createdAt    DateTime      @default(now())
  deleteAt     DateTime?
}

model Participant {
  id              String           @id
  name            String
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId         String
  expensesPaidBy  Expense[]
  expensesPaidFor ExpensePaidFor[]
  receiptsPaid       Receipt[]   @relation("ReceiptPaidBy")
  receiptsCreated    Receipt[]   @relation("ReceiptCreatedBy")
  itemClaims         ItemClaim[] @relation("ItemClaimParticipant")
  itemClaimsAssigned ItemClaim[] @relation("ItemClaimAssignedBy")
}

model Category {
  id       Int       @id @default(autoincrement())
  grouping String
  name     String
  Expense  Expense[]
}

model Expense {
  id               String            @id
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenseDate      DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  title            String
  category         Category?         @relation(fields: [categoryId], references: [id])
  categoryId       Int               @default(0)
  amount           Int
  originalAmount   Int?
  originalCurrency String?
  conversionRate   Decimal?
  paidBy           Participant       @relation(fields: [paidById], references: [id], onDelete: Cascade)
  paidById         String
  paidFor          ExpensePaidFor[]
  groupId          String
  isReimbursement  Boolean           @default(false)
  splitMode        SplitMode         @default(EVENLY)
  createdAt        DateTime          @default(now())
  documents        ExpenseDocument[]
  notes            String?

  recurrenceRule         RecurrenceRule?       @default(NONE)
  recurringExpenseLink   RecurringExpenseLink?
  recurringExpenseLinkId String?
  receipt                Receipt?
}

enum ReceiptStatus {
  DRAFT     // items being reviewed/edited, no Expense yet
  OPEN      // claiming in progress; the generated Expense exists and is kept in sync
  FINALIZED // locked; Expense frozen
}

enum ItemClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReceiptAdjustmentKind {
  TAX
  TIP
  DISCOUNT
  FEE
}

model Receipt {
  id           String              @id
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  title        String
  receiptDate  DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  // Copied into the generated Expense. No relation on purpose (keeps Category untouched).
  categoryId   Int                 @default(0)
  paidBy       Participant         @relation("ReceiptPaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  paidById     String
  createdBy    Participant?        @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  status       ReceiptStatus       @default(DRAFT)
  imageUrl     String?
  imageWidth   Int?
  imageHeight  Int?
  // Total printed on the receipt (minor units), from OCR or typed. Only used for a mismatch warning.
  printedTotal Int?
  scanCount    Int                 @default(0)
  ocrModel     String?
  ocrRaw       Json?
  expense      Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId    String?             @unique
  items        ReceiptItem[]
  adjustments  ReceiptAdjustment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  finalizedAt  DateTime?

  @@index([groupId, status])
}

model ReceiptItem {
  id        String      @id
  receipt   Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String
  position  Int
  name      String
  quantity  Int         @default(1) // display only; splitting uses ItemClaim.shares
  amount    Int         // NET line total in minor units (after line-level coupons), >= 0
  taxable   Boolean     @default(true)
  claims    ItemClaim[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([receiptId, position])
}

model ReceiptAdjustment {
  id        String                @id
  receipt   Receipt               @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String
  position  Int
  kind      ReceiptAdjustmentKind
  label     String
  // Signed minor units: TAX/TIP/FEE > 0, DISCOUNT < 0.
  amount    Int

  @@index([receiptId])
}

model ItemClaim {
  id             String          @id
  // Denormalized for the approval inbox query (same idea as RecurringExpenseLink.groupId).
  groupId        String
  item           ReceiptItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId         String
  participant    Participant     @relation("ItemClaimParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  participantId  String
  // Who created the claim. Equal to participantId for a self-claim. Null if that participant was deleted.
  assignedBy     Participant?    @relation("ItemClaimAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById   String?
  // Integer weight within the item (1 = equal split). 1..100.
  shares         Int             @default(1)
  status         ItemClaimStatus @default(PENDING)
  // Item portion (minor units, before tax/fees) this participant last agreed to. Null until approved.
  approvedAmount Int?
  respondedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([itemId, participantId])
  @@index([groupId, participantId, status])
}

model ExpenseDocument {
  id        String   @id
  url       String
  width     Int
  height    Int
  Expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?
}

enum SplitMode {
  EVENLY
  BY_SHARES
  BY_PERCENTAGE
  BY_AMOUNT
}

model RecurringExpenseLink {
  id                    String  @id
  groupId               String
  currentFrameExpense   Expense @relation(fields: [currentFrameExpenseId], references: [id], onDelete: Cascade)
  currentFrameExpenseId String  @unique

  // Note: We do not want to link to the next expense because once it is created, it should be 
  // treated as it's own independent entity. This means that if a user wants to delete an Expense
  // and any prior related recurring expenses, they'll need to delete them one by one.
  nextExpenseCreatedAt DateTime?
  nextExpenseDate      DateTime
  // Day of month (1-31) a monthly series repeats on. Null for daily and weekly.
  // A 31st clamps in February and returns to the 31st in March.
  anchorDay            Int?

  @@index([groupId])
  @@index([groupId, nextExpenseCreatedAt, nextExpenseDate(sort: Desc)])
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model ExpensePaidFor {
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expenseId     String
  participantId String
  shares        Int         @default(1)

  @@id([expenseId, participantId])
}

model Activity {
  id            String       @id
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  time          DateTime     @default(now())
  activityType  ActivityType
  participantId String?
  expenseId     String?
  data          String?
}

enum ActivityType {
  UPDATE_GROUP
  CREATE_EXPENSE
  UPDATE_EXPENSE
  DELETE_EXPENSE
  SCHEDULE_GROUP_DELETION
  RESTORE_GROUP
}
